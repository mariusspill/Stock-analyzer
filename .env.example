# Copy to .env and fill in. .env is never committed.
#
# The password is used for BOTH the MySQL root account inside the container and
# the client connections, so pick it once here and the stack is consistent.
SQL_CONNECTION_PW=change-me

# Where the database lives, from the point of view of the process connecting.
#   Running on the host (uv run ...) against the container:  localhost + 3307
#   Running inside a container (docker compose ...):         overridden to db + 3306
SQL_HOST=localhost
SQL_PORT=3307
SQL_USER=root
SQL_DATABASE=stockdb

# Host port the container's MySQL is published on. Defaults to 3307 because a
# native MySQL install usually already owns 3306.
DB_HOST_PORT=3307

# Host port for the Streamlit frontend.
APP_HOST_PORT=8502

# "full" fetches every registered security; "djia" limits price fetches to the
# 30 Dow components, which is what you want for a quick smoke test.
FETCH_UNIVERSE=full
