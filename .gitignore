# Raw data lake -- far too large for git, synced separately.
Data/

# Database dumps. Tracked directory, untracked contents: size is unknown until
# the first real dump, so how these get shared between machines is decided then.
backups/*
!backups/.gitkeep

# Local secrets. .env.example is the tracked template.
.env

# Environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
